# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# This file configures the Docker Compose stack (docker-compose.yml).

# --- LLM provider (pick ONE; Gemini free tier is the $0 default) ---
# Get a free key at https://aistudio.google.com/apikey (no card required).
GOOGLE_API_KEY=
# Free fallback, independent of Google's quota pool (https://console.groq.com/keys):
GROQ_API_KEY=
# Optional paid alternative (https://console.anthropic.com):
ANTHROPIC_API_KEY=
# Optional paid multi-model gateway (https://openrouter.ai/keys):
OPENROUTER_API_KEY=

# "dev" = cheap/fast model, "eval" = stronger model. See llm/provider.py.
PENTEST_AGENTS_MODE=dev

# --- Initial authorized scope ---
# The dashboard lets you save one or more IP addresses/CIDR ranges.
# This value seeds the saved scope on a fresh install. It never authorizes
# targets outside the addresses/ranges you specify.
# For the optional local Juice Shop, add 172.30.255.10/32 in the dashboard.
PENTEST_AGENTS_LAB_CIDR=192.168.56.0/24

# --- HexStrike tool image size ---
# "curated" = only the tools in mcp_client.py's role allowlist (smaller/faster).
# "full"    = the full Kali tool set (multi-GB, slow first build).
HEXSTRIKE_TOOLSET=curated
